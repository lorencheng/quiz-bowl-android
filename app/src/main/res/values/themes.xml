<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal XML theme — actual theming is done in Compose via ui/theme/Theme.kt -->
<resources>
    <style name="Theme.QuizBowlAndroid" parent="android:Theme.Material.NoActionBar">
        <!--
            The app forces dark mode (QuizBowlTheme darkTheme = true), so pin the window
            background to BgDark. Without this the platform's default grey shows through
            on cold start and behind any screen that doesn't paint its own background.
        -->
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
</resources>
