<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Power mark asterisk (✱) rendered as 3 stroke lines through center.
        Stroke lines are inherently cleaner than filled shapes — the arms are
        distinct and the center reads as a point, not a blob.
        Arms span from y=20 to y=88 (68dp), centered at (54,54).
        strokeLineCap="round" gives the classic rounded-arm asterisk look.
    -->

    <!-- 0° — vertical -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:pathData="M54,33 L54,75"/>

    <!-- 60° -->
    <group
        android:rotation="60"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:pathData="M54,33 L54,75"/>
    </group>

    <!-- 120° -->
    <group
        android:rotation="120"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="10"
            android:strokeLineCap="round"
            android:pathData="M54,33 L54,75"/>
    </group>
</vector>
